    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "tsx": "^4.20.0",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "@types/jsdom": "^30.0.0",
    "better-sqlite3": "^13.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9"
